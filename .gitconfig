[user]
	name = James Vickery
	email = 14852491+jmsv@users.noreply.github.com
[alias]
	s = status
	a = add
	b = branch -vv
	ba = branch --all
	aa = add -A
	co = checkout
	cb = checkout -b
	com = checkout main
	cod = checkout dev
	cos = checkout staging
	ci = commit
	cim = commit -m
	cine = commit --no-edit
	ciam = commit -a -m
	rv = remote -v
	up = push
	down = pull
	po = push origin
	f = fetch
	fa = fetch --all
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	ch = cherry-pick
	sub = submodule
	subs = submodule
	subf = submodule foreach
	subinit = submodule update --init --recursive
	subm = submodule foreach git checkout master
	subpull = submodule foreach git pull
	diffc = diff --cached
	diffm = diff origin/main
	diffmn = diff origin/main --name-only
	fresh = clean -dxf
	undocommit = reset HEAD~
	undoci = reset HEAD~
	uci = reset HEAD~
	fuck = commit --amend
	pullx = !git stash && git pull && git stash pop
	pom = pull origin main
	pushu = push -u
	pushuo = push -u origin
	chp = cherry-pick
	st = stash
	stu = stash -u
	stp = stash pop
	wt = worktree
	wtl = worktree list
	wta = "!f() { git fetch origin main && git worktree add \"$1\" -b \"$1\" origin/main --no-track; }; f"
	wtad = "!f() { git fetch origin develop && git worktree add \"$1\" -b \"$1\" origin/develop --no-track; }; f"
	wtco = "!f() { git fetch origin \"$1\" && git worktree add \"$1\" \"$1\"; }; f"
	wtr = worktree remove
	wtp = worktree prune
	pub = !git push -u origin "$(git branch --show-current)"
	pish = push
[core]
	editor = vim
[push]
	default = simple
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[pull]
	rebase = false
[checkout]
	defaultRemote = origin
[diff "lockb"]
	textconv = bun
	binary = true
